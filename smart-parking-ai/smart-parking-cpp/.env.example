# ============================================================
# Smart Parking AI — Environment Configuration
# ============================================================

# Google Cloud API Key (required for live data collection)
# IMPORTANT: Keep this key secret. Never commit it to version control.
# Restrict this key in Google Cloud Console to only the APIs used.
GOOGLE_MAPS_API_KEY="your-key-here"

# C++ Engine Port (internal communication)
CPP_ENGINE_PORT=5001

# Python API Port (exposed)
PYTHON_API_PORT=8080

# ============================================================
# Security Configuration
# ============================================================

# Allowed CORS origins (comma-separated, no spaces)
# Only these origins can make cross-origin requests
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Allowed Host headers (comma-separated)
# Requests with Host headers not on this list are rejected
ALLOWED_HOSTS=localhost,127.0.0.1

# Enable Swagger/OpenAPI documentation
# Disabled by default for production security
ENABLE_DOCS=0

# IP Blocklist (comma-separated)
# Requests from these IPs will be rejected
BLOCKED_IPS=

# IP Allowlist (comma-separated)
# If set, ONLY requests from these IPs will be allowed
ALLOWED_IPS=

# Rate limiting (requests per 60-second window)
# RATE_LIMIT_MAX=60

# C++ Engine CORS origin (must match the frontend origin)
# Defaults to http://localhost:8080 if not set
CPP_CORS_ORIGIN=http://localhost:8080
